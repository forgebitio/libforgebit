@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# libsodium is linked privately into the shared library, but static
# archives do not embed it -- consumers of Forgebit::static must link it.
find_dependency(PkgConfig REQUIRED)
pkg_check_modules(Forgebit_SODIUM REQUIRED IMPORTED_TARGET libsodium)

include("${CMAKE_CURRENT_LIST_DIR}/ForgebitTargets.cmake")

if(TARGET Forgebit::static)
    set_property(TARGET Forgebit::static APPEND PROPERTY
        INTERFACE_LINK_LIBRARIES PkgConfig::Forgebit_SODIUM
    )
endif()

# Convenience alias: prefer shared when both were installed.
if(NOT TARGET Forgebit::forgebit)
    if(TARGET Forgebit::shared)
        add_library(Forgebit::forgebit INTERFACE IMPORTED)
        set_target_properties(Forgebit::forgebit PROPERTIES
            INTERFACE_LINK_LIBRARIES Forgebit::shared
        )
    elseif(TARGET Forgebit::static)
        add_library(Forgebit::forgebit INTERFACE IMPORTED)
        set_target_properties(Forgebit::forgebit PROPERTIES
            INTERFACE_LINK_LIBRARIES Forgebit::static
        )
    endif()
endif()

check_required_components(Forgebit)
